{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"],
  // The helper tests are run by the ROOT vitest (vitest.config.ts includes ui/src/lib), and there
  // is deliberately no vitest install under ui/. They must therefore stay out of the dashboard's
  // own typecheck, or `npm ci && npm run build` in this directory alone cannot resolve `vitest` --
  // which is exactly what the Dockerfile's ui stage does.
  "exclude": ["src/**/*.test.ts"]
}
