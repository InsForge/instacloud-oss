{
  "name": "@insforge/instacloud-oss",
  "version": "0.2.0",
  "description": "Self-hostable runtime for branchable, agent-native environments: per-project database, object storage, and app containers; every branch is a disposable isolated clone. Driven by the standard insta CLI.",
  "type": "module",
  "bin": {
    "instacloud-oss": "src/main.ts"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:ui": "npm --prefix ui install && npm --prefix ui run build",
    "build:image": "docker build --build-arg VERSION=$(node -p \"require('./package.json').version\") -t instacloud:dev ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.0",
    "tsx": "^4.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/InsForge/instacloud-oss.git"
  },
  "keywords": [
    "branchable-environments",
    "agent-native",
    "self-hosted",
    "docker",
    "postgres",
    "preview-environments",
    "hitl-governance"
  ]
}
