  },
  "seo": {
    "metatags": {
      "og:site_name": "InstaCloud Docs | Cloud infrastructure for the era of agents",
      "description": "InstaCloud is the cloud infrastructure built from the ground up to serve agents: database, storage, and compute that branch per task, with credentials through one seam."
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search InstaCloud docs..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      "mcp"
