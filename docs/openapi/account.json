{
  "openapi": "3.1.0",
  "info": {
    "title": "InstaCloud API — Account level",
    "version": "0.1.0",
    "description": "Endpoints that act as the token's owner: their organizations, their API tokens, and the public catalog. Creating an organization needs an account-wide token.\n\nGenerated from the platform's own OpenAPI document (https://api.instacloud.com/openapi.json); see the [API overview](/reference/api/overview) for authentication and token scopes."
  },
  "servers": [
    {
      "url": "https://api.instacloud.com",
      "description": "InstaCloud"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "The caller, their organizations and API tokens."
    },
    {
      "name": "Catalog",
      "description": "Public catalogs: templates and regions. No token needed."
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Current user",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/PublicUser"
                    },
                    "via": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "jwt"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "api"
                          ]
                        }
                      ]
                    },
                    "agentCredential": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "token": {
                      "type": "object",
                      "properties": {
                        "scope": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "account"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "org"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "project"
                              ]
                            }
                          ]
                        },
                        "orgId": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "projectId": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "access": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "full"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "read_only"
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "scope",
                        "access"
                      ]
                    },
                    "impersonation": {
                      "type": "object",
                      "properties": {
                        "projectId": {
                          "type": "string"
                        },
                        "projectName": {
                          "type": "string"
                        },
                        "orgName": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "projectId",
                        "projectName",
                        "orgName"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "**Token scope:** `account` · `org` · `project` — read-only tokens allowed.",
        "x-mint": {
          "metadata": {
            "title": "Current user",
            "sidebarTitle": "Get me"
          }
        }
      },
      "patch": {
        "operationId": "updateMe",
        "summary": "Update the current user's profile (display name)",
        "tags": [
          "Account"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "name"
                ],
                "type": "object",
                "properties": {
                  "name": {
                    "maxLength": 100,
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/PublicUser"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "**Token scope:** `account` — read-only tokens refused (not a GET).",
        "x-mint": {
          "metadata": {
            "title": "Update the current user's profile (display name)",
            "sidebarTitle": "Update me"
          }
        }
      }
    },
