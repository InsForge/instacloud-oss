    "primary": "#07C983",
    "light": "#4ADE80",
    "dark": "#059669"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "section"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon-dark.svg"
