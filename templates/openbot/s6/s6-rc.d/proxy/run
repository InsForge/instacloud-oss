#!/command/with-contenv sh
# The authenticating face of this deployment.
#
# WHY THIS EXISTS. OpenBot's no-sign-in mode (OPENBOT_SINGLE_USER) admits every request as one
# administrator, and upstream REFUSES TO START when it is combined with an address the public
# internet reaches: see singleUserAllowed in server/src/config.ts. It is right to refuse. The only
# alternative upstream offers is a registered OAuth client, whose redirect URI has to match a URL
# that does not exist until the deploy does, so a template cannot ask for one. This closes the gap
# the other way: OpenBot keeps its loopback-only listener and believes what it is told, and the
# public port is HTTP basic auth in front of it.
#
# NOT A SECOND APPLICATION. It terminates nothing, rewrites nothing and stores nothing. Every
# request that carries the credential is passed to 127.0.0.1:3001 unchanged. The config it runs is
# /etc/caddy/Caddyfile, committed beside this file and validated at build time.
#
# It depends on no other service on purpose, so that whatever happens inside upstream's startup
# chain the routed port is still answering and says 502 rather than refusing the connection.
set -eu

# Neither gets a fallback on purpose. The manifest declares both required with no default, so the
# platform always supplies them; a missing one means the image was started some other way, and
# inventing `admin` there would publish a browser-driving agent to whoever finds the URL.
: "${ADMIN_USERNAME:?ADMIN_USERNAME is required}"
: "${ADMIN_PASSWORD:?ADMIN_PASSWORD is required}"
PROXY_PORT="${PROXY_PORT:-8080}"

# The username is substituted into a Caddyfile, so it has to be one token. Refused loudly rather
# than left to produce a config error naming a line nobody wrote.
case "$ADMIN_USERNAME" in
  '' | *[!A-Za-z0-9._-]*)
    echo "proxy: ADMIN_USERNAME may contain only letters, digits, '.', '-' and '_'" >&2
    exit 1 ;;
esac

# bcrypt will not take more than 72 bytes of password. Bytes, not characters: ${#ADMIN_PASSWORD}
# counts characters, which differ under a non-C locale. Said here, with the number, rather than
# left to surface as whatever the hashing step does with the 73rd byte.
PASS_BYTES=$(printf '%s' "$ADMIN_PASSWORD" | wc -c)
if [ "$PASS_BYTES" -gt 72 ]; then
  echo "proxy: ADMIN_PASSWORD is $PASS_BYTES bytes; bcrypt will not take more than 72" >&2
  exit 1
fi

# A line break inside the password is refused rather than hashed, for the same reason the trailing
# one below is load-bearing: `hash-password` reads ONE line. `pw\nrest` would authenticate on `pw`
# alone, so the operator would believe in a password that is not the one guarding the box, and a
# leading break would hash the empty string. Counted rather than matched, because `$(printf '\n')`
# strips the newline it is meant to find.
if [ "$(printf '%s' "$ADMIN_PASSWORD" | tr -d '\n\r' | wc -c)" -ne "$PASS_BYTES" ]; then
  echo "proxy: ADMIN_PASSWORD may not contain a line break: only the first line would be used" >&2
  exit 1
fi

# Piped, never `--plaintext`: an argument is visible in /proc/<pid>/cmdline to every process in
# this container, and one of them is the shell a Bot is allowed to run. /proc/<pid>/environ is not,
# which is why the hash travels to Caddy as an exported variable below rather than as an argument.
#
# THE TRAILING NEWLINE IS LOAD-BEARING. With stdin not a terminal, `hash-password` reads with
# bufio.ReadBytes('\n') and returns the error that comes back verbatim, so input with no newline
# gives it io.EOF and the command fails with the single word "EOF". That is what the first build of
# this template did, once a second, forever, with the deploy reporting only an unready port.
PROXY_PASSWORD_HASH=$(printf '%s\n' "$ADMIN_PASSWORD" | /usr/local/bin/caddy hash-password)
export PROXY_PASSWORD_HASH PROXY_PORT ADMIN_USERNAME

# The password itself has no further use here, and the process below is the one on the public port.
unset ADMIN_PASSWORD

# Caddy wants somewhere to put a data directory even with its admin API and config persistence
# turned off, so both XDG roots point at a directory of its own under the container's tmpfs.
mkdir -p /run/caddy
chown proxyuser:proxyuser /run/caddy
export HOME=/home/proxyuser XDG_CONFIG_HOME=/run/caddy XDG_DATA_HOME=/run/caddy

# Not root. This is the one process the public internet talks to, and the base image is careful
# that the browser, the API and the database each run as someone different; this continues that.
exec s6-setuidgid proxyuser \
  /usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
